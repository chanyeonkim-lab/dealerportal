# Optional live extraction and sales assistant. Supply locally, never commit values.
OPENAI_API_KEY=
# Alternative environment-settings binding:
DEALER_OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Local prototype only. Tracing disabled to avoid sending contract PII to traces.
OPENAI_AGENTS_DISABLE_TRACING=1
# Optional first-seed overrides for the two fictional demo logins.
# DEALER_DEMO_PASSWORD=
# INTERNAL_DEMO_PASSWORD=
# Persistent local SQLite directory (defaults to .data).
# DEALER_DATA_DIR=
# Explicit public origin when running behind a reverse proxy.
# APP_ORIGIN=http://localhost:3000
